#!/usr/bin/env bash
# Clear Jupyter notebook outputs before each commit.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

notebooks="$(git diff --cached --name-only --diff-filter=ACMR -- '*.ipynb' || true)"
if [ -z "$notebooks" ]; then
  exit 0
fi

args=()
while IFS= read -r notebook; do
  [ -n "$notebook" ] || continue
  args+=("$notebook")
done <<< "$notebooks"

uv run python scripts/clear_notebook_outputs.py "${args[@]}" >/dev/null

modified="$(git diff --name-only -- "${args[@]}" || true)"
if [ -n "$modified" ]; then
  while IFS= read -r notebook; do
    [ -n "$notebook" ] || continue
    git add "$notebook"
  done <<< "$modified"

  echo "pre-commit: cleared notebook outputs:" >&2
  while IFS= read -r notebook; do
    [ -n "$notebook" ] || continue
    printf '  %s\n' "$notebook" >&2
  done <<< "$modified"
fi

exit 0
